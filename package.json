    "astro": "^7.4.0",
    "satori": "^0.62.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "knip": "^6.41.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "stylelint": "^17.16.0",
