---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { PUBLIC_UMAMI_WEBSITE_ID } from "astro:env/client";

import SeoHead from "@/components/seo/SeoHead.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
import SkipLink from "@/components/site/SkipLink.astro";
import type { Seo } from "@/lib/seo/types";
import "@/styles/global.css";

interface Props extends Seo {
  /** The home hero sets the wordmark and the email above the fold; other pages open on a title. */
  hero?: boolean;
}

const { hero = false, ...seo } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead {...seo} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f9f9f9" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Faces set in the first viewport are preloaded so they are in place for the first paint;
         the mono, a few short strings, swaps in when it arrives (see astro.config.ts). -->
    <Font cssVariable="--font-archivo-wordmark" preload={hero} />
    <Font cssVariable="--font-stack-sans-headline" preload={!hero} />
    <Font cssVariable="--font-stack-sans-text" preload />
    <Font cssVariable="--font-stack-sans-notch" preload={hero} />
    <Font cssVariable="--font-fragment-mono" />
    {/* Tracking is limited to the production domain, so Lighthouse runs on localhost count nothing. */}
    {PUBLIC_UMAMI_WEBSITE_ID && (
      <script
        is:inline
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id={PUBLIC_UMAMI_WEBSITE_ID}
        data-domains={Astro.site?.hostname}
      />
    )}
    <!-- Page transitions: same-document View Transitions, see docs/architecture.md. -->
    <ClientRouter />
  </head>
  <body>
    <SkipLink target="main" />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import "@/scripts/transition-direction";
    </script>
  </body>
</html>
