---
import Cell from "@/components/ui/Cell.astro";
import EmailLink from "@/components/ui/EmailLink.astro";
import Media from "@/components/ui/Media.astro";
import Sheet from "@/components/ui/Sheet.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile } from "@/data/profile";
import { useTranslations } from "@/i18n/ui";

// GitHub Pages serves this one page for every missing address, French ones included: it says
// it in both languages, each leading to its own home page.
const en = useTranslations("en");
const fr = useTranslations("fr");
---

<BaseLayout title={`Page not found · ${profile.name}`} description="This page does not exist." noindex>
  <div class="page">
    <Sheet aria-labelledby="not-found-title">
      <Cell span={4} flush as="figure">
        <Media
          src={profile.avatar.src}
          alt={profile.avatar.alt}
          ratio="1 / 1"
          sizes="(width >= 60rem) 33vw, 100vw"
          widths={[320, 640]}
        />
      </Cell>
      <Cell span={8} class="message">
        <h1 id="not-found-title">{en("notFound.title")}</h1>
        <p>{en("notFound.text")}</p>
        <p>
          <a class="tap" href="/">
            {en("notFound.home")}
          </a>
        </p>
        <div class="other-language" lang="fr">
          <p class="other-title">{fr("notFound.title")}</p>
          <p>{fr("notFound.text")}</p>
          <p>
            <a class="tap" href="/fr/">
              {fr("notFound.home")}
            </a>
          </p>
        </div>
        <EmailLink />
      </Cell>
    </Sheet>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block-start: var(--layout-gutter);
  }

  .message {
    display: grid;
    align-content: center;
    gap: var(--space-4);
    padding-block: var(--space-12);
  }

  h1 {
    font-size: var(--font-size-step-3);
  }

  .other-language {
    display: grid;
    gap: var(--space-2);
    padding-block-start: var(--space-4);
    border-block-start: var(--border-hairline);
    color: var(--color-text-muted);
  }

  .other-title {
    color: var(--color-text);
    font-weight: var(--font-weight-strong);
  }
</style>
