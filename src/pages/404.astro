---
import Cell from "@/components/ui/Cell.astro";
import EmailLink from "@/components/ui/EmailLink.astro";
import Media from "@/components/ui/Media.astro";
import Sheet from "@/components/ui/Sheet.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile } from "@/data/profile";
---

<BaseLayout title={`Page not found · ${profile.name}`} description="This page does not exist." noindex>
  <div class="page">
    <Sheet aria-labelledby="not-found-title">
      <Cell span={4} flush as="figure">
        <Media
          src={profile.avatar.src}
          alt={profile.avatar.alt}
          ratio="1 / 1"
          sizes="(width >= 60rem) 33vw, 100vw"
          widths={[320, 640]}
        />
      </Cell>
      <Cell span={8} class="message">
        <h1 id="not-found-title">This page does not exist</h1>
        <p>It may have moved when the site was rebuilt. The home page has everything, and the email still works.</p>
        <p>
          <a href="/">Back to the home page</a>
        </p>
        <EmailLink />
      </Cell>
    </Sheet>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block-start: var(--layout-gutter);
  }

  .message {
    display: grid;
    align-content: center;
    gap: var(--space-4);
    padding-block: var(--space-12);
  }

  h1 {
    font-size: var(--font-size-step-3);
  }
</style>
