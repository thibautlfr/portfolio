---
// Development-only review page for the tokens and base components (V1b).
// The route only exists under `astro dev`: production builds emit nothing.
import Cell from "@/components/ui/Cell.astro";
import FactList from "@/components/ui/FactList.astro";
import Media from "@/components/ui/Media.astro";
import Sheet from "@/components/ui/Sheet.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import portrait from "@/assets/images/portrait.jpg";
import { profile } from "@/data/profile";

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { styleguide: "styleguide" } }] : [];
}

const colors = [
  "ground",
  "surface",
  "text",
  "text-muted",
  "line",
  "accent",
  "accent-text",
  "link",
  "focus",
  "selection",
];
const steps = ["minus-1", "0", "1", "2", "3", "5"];
const spaces = [1, 2, 3, 4, 6, 8, 12, 16, 24];
---

<BaseLayout title="Styleguide" description="Tokens and base components." preloadWordmark>
  <div class="sheets">
    <Sheet aria-labelledby="styleguide-title">
      <Cell>
        <h1 id="styleguide-title" class="wordmark">
          {profile.name}
        </h1>
      </Cell>
      <Cell span={8}>
        <p>Tokens and base components, for review. This page only exists in development.</p>
      </Cell>
      <Cell span={4}>
        <a class="email" href={`mailto:${profile.email}`}>
          {profile.email}
        </a>
      </Cell>
    </Sheet>

    <Sheet aria-labelledby="colours-title">
      <Cell>
        <h2 id="colours-title">Colour roles</h2>
      </Cell>
      {colors.map((name) => (
        <Cell span={3}>
          <div class="swatch" style={`background: var(--color-${name})`} />
          <code>--color-{name}</code>
        </Cell>
      ))}
    </Sheet>

    <Sheet aria-labelledby="type-title">
      <Cell>
        <h2 id="type-title">Type</h2>
      </Cell>
      <Cell span={6}>
        <p class="label">Wordmark, Archivo 800 at 125%</p>
        <p class="wordmark">{profile.name}</p>
      </Cell>
      <Cell span={6}>
        <p class="label">Email, Stack Sans Notch 700</p>
        <p class="email">{profile.email}</p>
      </Cell>
      {steps.map((step) => (
        <Cell span={6}>
          <p class="label">
            <code>--font-size-step-{step}</code>
          </p>
          <p class="sample" style={`font-size: var(--font-size-step-${step})`}>
            Selected work, built to last
          </p>
        </Cell>
      ))}
      <Cell span={6}>
        <p class="label">Text, Stack Sans Text 400</p>
        <p>
          I build web platforms that run in production, and I sweat the parts people see. TypeScript end to end, WebGL
          when it earns its place.
        </p>
      </Cell>
      <Cell span={6}>
        <p class="label">Data, Fragment Mono 400</p>
        <p>
          <code>TypeScript, Node.js, PostgreSQL, Three.js · 46.16° N, 1.15° W</code>
        </p>
      </Cell>
    </Sheet>

    <Sheet aria-labelledby="space-title">
      <Cell>
        <h2 id="space-title">Space</h2>
      </Cell>
      {spaces.map((space) => (
        <Cell span={4}>
          <code>--space-{space}</code>
          <div class="space" style={`inline-size: var(--space-${space})`} />
        </Cell>
      ))}
    </Sheet>

    <Sheet aria-labelledby="components-title">
      <Cell>
        <h2 id="components-title">Components</h2>
      </Cell>
      <Cell span={4} flush as="figure">
        <Media
          src={portrait}
          alt="Black and white portrait of Thibaut Lefrançois."
          ratio="1 / 1"
          sizes="(width >= 60rem) 33vw, 100vw"
        />
      </Cell>
      <Cell span={8}>
        <FactList
          facts={[
            { term: "Context", value: "Client SaaS" },
            { term: "Role", value: "Full-stack developer" },
            { term: "Stack", value: "TypeScript, Node.js, Microservices", data: true },
          ]}
        />
        <p class="links">
          <a href="#components-title">A text link</a>
        </p>
      </Cell>
    </Sheet>
  </div>
</BaseLayout>

<style>
  .sheets {
    display: grid;
    gap: var(--space-12);
    padding-block-start: var(--layout-gutter);
  }

  .wordmark {
    font-family: var(--font-wordmark);
    font-size: var(--font-size-step-5);
    font-weight: var(--font-weight-wordmark);
    font-stretch: var(--font-stretch-wordmark);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-wordmark);
  }

  .email {
    font-family: var(--font-email);
    font-size: var(--font-size-step-2);
    font-weight: var(--font-weight-title);
  }

  h2 {
    font-size: var(--font-size-step-3);
  }

  .label,
  code {
    color: var(--color-text-muted);
    font-size: var(--font-size-step-minus-1);
  }

  .label {
    margin-block-end: var(--space-2);
  }

  .sample {
    font-family: var(--font-title);
    font-weight: var(--font-weight-title);
    line-height: var(--line-height-title);
  }

  .swatch {
    block-size: var(--space-16);
    margin-block-end: var(--space-2);
    outline: var(--border-hairline);
  }

  .space {
    block-size: var(--space-4);
    margin-block-start: var(--space-2);
    background: var(--color-accent);
  }

  .links {
    margin-block-start: var(--space-4);
  }
</style>
