---
// Temporary home until Phase 3: checks that fonts and collections load.
import { getCollection } from "astro:content";

import Cell from "@/components/ui/Cell.astro";
import Sheet from "@/components/ui/Sheet.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile } from "@/data/profile";
import { selectFeatured, selectLatest } from "@/lib/content";

const projects = selectFeatured(await getCollection("projects"));
const notes = selectLatest(await getCollection("notes"), 3);
---

<BaseLayout title={profile.name} description={`${profile.name}, ${profile.role}.`} preloadWordmark>
  <div class="page">
    <Sheet aria-labelledby="hero-title">
      <Cell>
        <h1 id="hero-title" class="wordmark">
          {profile.name}
        </h1>
        <p class="role">{profile.role}</p>
      </Cell>
      <Cell>
        <a class="email" href={`mailto:${profile.email}`}>
          {profile.email}
        </a>
      </Cell>
    </Sheet>
    <Sheet aria-label="Content check">
      <Cell span={6}>
        <ul>
          {projects.map((project) => (
            <li>{project.data.title}</li>
          ))}
        </ul>
      </Cell>
      <Cell span={6}>
        <ul>
          {notes.map((note) => (
            <li>{note.data.title}</li>
          ))}
        </ul>
      </Cell>
    </Sheet>
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-12);
    padding-block-start: var(--layout-gutter);
  }

  .wordmark {
    font-family: var(--font-wordmark);
    font-size: var(--font-size-step-5);
    font-weight: var(--font-weight-wordmark);
    font-stretch: var(--font-stretch-wordmark);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-wordmark);
  }

  .role {
    margin-block-start: var(--space-8);
    font-size: var(--font-size-step-1);
  }

  .email {
    font-family: var(--font-email);
    font-size: var(--font-size-step-2);
    font-weight: var(--font-weight-title);
  }
</style>
