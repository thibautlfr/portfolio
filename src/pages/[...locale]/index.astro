---
import AboutSection from "@/components/home/AboutSection.astro";
import ArtworkSection from "@/components/home/ArtworkSection.astro";
import ContactSection from "@/components/home/ContactSection.astro";
import Hero from "@/components/home/Hero.astro";
import NotesSection from "@/components/home/NotesSection.astro";
import PlaygroundSection from "@/components/home/PlaygroundSection.astro";
import TestimonialSection from "@/components/home/TestimonialSection.astro";
import WorkSection from "@/components/home/WorkSection.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { localProfile } from "@/data/profile";
import { getLocalizedCollection } from "@/i18n/content";
import { localeOf, localeStaticPaths, locales, ogPath } from "@/i18n/locales";
import { useTranslations } from "@/i18n/ui";
import { selectFeatured, selectLatest } from "@/lib/content";
import { profilePage } from "@/lib/seo/json-ld";
import { author } from "@/lib/seo/site";

export const getStaticPaths = localeStaticPaths;

const locale = localeOf(Astro.url);
const t = useTranslations(locale);
const profile = localProfile(locale);

const projects = selectFeatured(await getLocalizedCollection("projects", locale));
const experiments = selectFeatured(await getLocalizedCollection("playground", locale));
const artworks = selectFeatured(await getLocalizedCollection("artworks", locale));
const notes = selectLatest(await getLocalizedCollection("notes", locale), 3);
const recommended = Object.values(profile.collaborations).find((collaboration) => collaboration.testimonial);
const instagram = profile.socials.find((social) => social.label === "Instagram");
const person = await author(Astro.site ?? Astro.url, locale);
---

<BaseLayout
  title={`${profile.name}, ${profile.role}`}
  description={t("home.description", {
    role: profile.role,
    city: profile.location.city,
    positioning: profile.positioning,
  })}
  ogImage={ogPath("/home", locale)}
  jsonLd={[profilePage(person, locale)]}
  {locales}
  hero
>
  <div class="page">
    <Hero {profile} {locales} />
    <WorkSection title={t("work.title")} {projects} />
    <AboutSection
      title={t("about.title")}
      offers={[
        { title: t("about.teamTitle"), text: t("about.teamText") },
        { title: t("about.productTitle"), text: t("about.productText") },
      ]}
      factsTitle={t("about.factsTitle")}
      clientsTitle={t("about.clientsTitle")}
      {profile}
    />
    {recommended?.testimonial && (
      <TestimonialSection
        title={t("testimonial.title")}
        testimonial={recommended.testimonial}
        organisation={recommended.name}
        source={t("testimonial.source")}
      />
    )}
    {experiments.length > 0 && <PlaygroundSection title={t("playground.title")} {experiments} />}
    {artworks.length > 0 && (
      <ArtworkSection
        title={t("artworks.title")}
        {artworks}
        more={instagram && { label: t("artworks.more"), url: instagram.url }}
      />
    )}
    {notes.length > 0 && <NotesSection title={t("notes.title")} {notes} />}
    <ContactSection title={t("contact.title")} socialsLabel={t("contact.socials")} />
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-12);
    padding-block-start: var(--layout-gutter);
  }

  /* Sections below the hero are laid out when they come near the viewport, not on the first
     render: the first paint only pays for the hero. Their last measured size is kept. Only on
     a page loaded by the browser: one brought back by the router is new, has no size kept,
     and its scroll is restored at once, so sections still at their placeholder height would
     put the visitor far below where they left. */
  :global(:root:not([data-routed])) .page > :global(:not(:first-child)) {
    content-visibility: auto;
    contain-intrinsic-block-size: auto 40rem;
  }
</style>

<script>
  // The router copies the attributes of the incoming <html> onto the current one.
  document.addEventListener("astro:before-swap", (event) => {
    event.newDocument.documentElement.dataset.routed = "";
  });
</script>
