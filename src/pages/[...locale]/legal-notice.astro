---
import Breadcrumbs from "@/components/site/Breadcrumbs.astro";
import Cell from "@/components/ui/Cell.astro";
import Sheet from "@/components/ui/Sheet.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile } from "@/data/profile";
import { localeOf, localeStaticPaths, locales, localizePath } from "@/i18n/locales";
import { useTranslations } from "@/i18n/ui";

export const getStaticPaths = localeStaticPaths;

const { legal, email } = profile;
const locale = localeOf(Astro.url);
const t = useTranslations(locale);
const [blockBefore, blockAfter] = t("legal.optOutBlock").split("{domain}");
---

<BaseLayout
  title={`${t("legal.title")} · ${profile.name}`}
  description={t("legal.description", { name: profile.name })}
  {locales}
>
  <div class="page">
    <Sheet aria-labelledby="legal-title">
      <Breadcrumbs
        items={[{ label: profile.name, href: localizePath("/", locale) }, { label: t("legal.title") }]}
        {locales}
      />
      <Cell as="header" class="title-block">
        <h1 id="legal-title">{t("legal.title")}</h1>
        <p>{t("legal.intro")}</p>
      </Cell>

      <!-- One row per topic: the topic in a narrow cell, the text beside it. -->
      <Cell span={4} class="topic">
        <h2>{t("legal.publisher")}</h2>
      </Cell>
      <Cell span={8} class="statement">
        <dl class="facts">
          <div>
            <dt>{t("legal.name")}</dt>
            <dd>{t("legal.individual", { name: legal.publisher })}</dd>
          </div>
          <div>
            <dt>{t("legal.contact")}</dt>
            <dd>
              <a href={`mailto:${email}`}>{email}</a>
            </dd>
          </div>
        </dl>
        <p>{t("legal.address")}</p>
      </Cell>

      <Cell span={4} class="topic">
        <h2>{t("legal.hosting")}</h2>
      </Cell>
      <Cell span={8} class="statement">
        <dl class="facts">
          <div>
            <dt>{t("legal.name")}</dt>
            <dd>{legal.host.name}</dd>
          </div>
          <div>
            <dt>{t("legal.hostAddress")}</dt>
            <dd>{legal.host.address}</dd>
          </div>
          <div>
            <dt>{t("legal.website")}</dt>
            <dd>
              <a href={legal.host.url}>{legal.host.url.replace("https://", "")}</a>
            </dd>
          </div>
        </dl>
      </Cell>

      <Cell span={4} class="topic">
        <h2>{t("legal.data")}</h2>
      </Cell>
      <Cell span={8} class="statement">
        <p>{t("legal.dataText")}</p>
        <p>
          {blockBefore}
          <code>cloud.umami.is</code>
          {blockAfter}
        </p>
        <!-- Shown by the script, which needs storage to keep the choice; it remembers it in this browser only. -->
        <div class="opt-out" data-analytics-opt-out aria-live="polite" hidden>
          <p data-opt-out-state="counted">
            {t("legal.counted")} <button type="button">{t("legal.stop")}</button>
          </p>
          <p data-opt-out-state="stopped" hidden>
            {t("legal.stopped")} <button type="button">{t("legal.resume")}</button>
          </p>
        </div>
        <p>{t("legal.emails")}</p>
      </Cell>

      <Cell span={4} class="topic">
        <h2>{t("legal.property")}</h2>
      </Cell>
      <Cell span={8} class="statement">
        <p>{t("legal.propertyText", { name: legal.publisher })}</p>
      </Cell>

      <Cell span={4} class="topic">
        <h2>{t("legal.law")}</h2>
      </Cell>
      <Cell span={8} class="statement">
        <p>{t("legal.lawText")}</p>
      </Cell>
    </Sheet>
  </div>
</BaseLayout>

<script>
  import "@/scripts/analytics-opt-out";
</script>

<style>
  .page {
    padding-block-start: var(--layout-gutter);
  }

  .title-block {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-8);
  }

  h1 {
    font-size: var(--font-size-step-5);
    line-height: var(--line-height-tight);
  }

  .title-block p {
    color: var(--color-text-muted);
  }

  /* Below 60rem the topic sits on top of its text: no hairline between them. */
  .topic {
    padding-block-end: 0;
    border-block-end: 0;
  }

  h2 {
    font-size: var(--font-size-step-1);
  }

  .statement {
    display: grid;
    gap: var(--space-4);
    padding-block-end: var(--space-6);
  }

  .statement > * {
    max-inline-size: var(--layout-measure);
  }

  /* A button set as a quiet link, like the lens demo's reset. */
  .opt-out button {
    padding: 0;
    border: 0;
    background: none;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .facts {
    display: grid;
    gap: var(--space-2);
  }

  .facts div {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--space-3);
  }

  dt {
    color: var(--color-text-muted);
  }

  a {
    color: var(--color-link);
  }

  @media (width >= 60rem) {
    .topic {
      padding-block-end: var(--space-6);
      border-block-end: var(--border-hairline);
    }
  }
</style>
