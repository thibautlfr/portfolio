---
import { getCollection } from "astro:content";

import NoteListItem from "@/components/note/NoteListItem.astro";
import Breadcrumbs from "@/components/site/Breadcrumbs.astro";
import Cell from "@/components/ui/Cell.astro";
import Sheet from "@/components/ui/Sheet.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { localProfile } from "@/data/profile";
import { localeOf, localeStaticPaths, locales, localizePath } from "@/i18n/locales";
import { useTranslations } from "@/i18n/ui";
import { selectLatest } from "@/lib/content";
import { breadcrumbs } from "@/lib/seo/json-ld";

export const getStaticPaths = localeStaticPaths;

const locale = localeOf(Astro.url);
const t = useTranslations(locale);
const profile = localProfile(locale);
const home = localizePath("/", locale);
const notes = selectLatest(await getCollection("notes"));
const site = Astro.site ?? Astro.url;
---

<BaseLayout
  title={`${t("notes.title")} · ${profile.name}`}
  description={t("notes.description")}
  jsonLd={[
    breadcrumbs([
      { name: profile.name, url: new URL(home, site).href },
      { name: t("notes.title"), url: new URL(Astro.url.pathname, site).href },
    ]),
  ]}
  {locales}
>
  <div class="page">
    <Sheet aria-labelledby="notes-title">
      <Breadcrumbs items={[{ label: profile.name, href: home }, { label: t("notes.title") }]} {locales} />
      <Cell as="header" class="title-block">
        <h1 id="notes-title">{t("notes.title")}</h1>
        <p>{t("notes.intro")}</p>
      </Cell>
      <ol role="list" class="notes">
        {notes.map((note) => (
          <NoteListItem {note} headingLevel={2} />
        ))}
      </ol>
    </Sheet>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block-start: var(--layout-gutter);
  }

  .title-block {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-8);
  }

  h1 {
    font-size: var(--font-size-step-5);
    line-height: var(--line-height-tight);
  }

  .notes {
    display: grid;
    grid-column: 1 / -1;
  }
</style>
