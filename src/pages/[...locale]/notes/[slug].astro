---
import Figure from "@/components/mdx/Figure.astro";
import Video from "@/components/mdx/Video.astro";
import Breadcrumbs from "@/components/site/Breadcrumbs.astro";
import ExternalMark from "@/components/ui/ExternalMark.astro";
import ArticleBody from "@/components/ui/ArticleBody.astro";
import Cell from "@/components/ui/Cell.astro";
import FactList from "@/components/ui/FactList.astro";
import Sheet from "@/components/ui/Sheet.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { localProfile } from "@/data/profile";
import { getLocalizedCollection, renderLocalized, type LocalizedEntry } from "@/i18n/content";
import { localeOf, localeParam, locales, localizePath } from "@/i18n/locales";
import { useTranslations } from "@/i18n/ui";
import { selectLatest } from "@/lib/content";
import { formatDate, isoDate } from "@/lib/format";
import { blogPosting, breadcrumbs } from "@/lib/seo/json-ld";

export async function getStaticPaths() {
  const paths = await Promise.all(
    locales.map(async (locale) =>
      selectLatest(await getLocalizedCollection("notes", locale)).map((note) => ({
        params: { locale: localeParam(locale), slug: note.id },
        props: { note },
      })),
    ),
  );
  return paths.flat();
}

interface Props {
  note: LocalizedEntry<"notes">;
}

const { note } = Astro.props;
const { title, description, pubDate, updatedDate, tags, source } = note.data;
const { Content, headings } = await renderLocalized(note);

const locale = localeOf(Astro.url);
const t = useTranslations(locale);
const profile = localProfile(locale);
// A note without its French file reads in English: the page says so and marks the text.
const { contentLocale } = note;
const home = localizePath("/", locale);
const list = localizePath("/notes/", locale);
const site = Astro.site ?? Astro.url;
const url = new URL(localizePath(`/notes/${note.id}/`, locale), site).href;
const platforms = { x: "X", linkedin: "LinkedIn" };
---

<BaseLayout
  title={`${title} · ${profile.name}`}
  {description}
  ogImage={`/og/notes/${note.id}.png`}
  type="article"
  jsonLd={[
    blogPosting({
      headline: title,
      description,
      url,
      authorUrl: site.href,
      datePublished: isoDate(pubDate),
      ...(updatedDate && { dateModified: isoDate(updatedDate) }),
      keywords: tags,
    }),
    breadcrumbs([
      { name: profile.name, url: new URL(home, site).href },
      { name: t("notes.title"), url: new URL(list, site).href },
      { name: title, url },
    ]),
  ]}
  {locales}
>
  <article class="page">
    <Sheet as="div">
      <Breadcrumbs
        items={[{ label: profile.name, href: home }, { label: t("notes.title"), href: list }, { label: title }]}
        {locales}
      />
      {contentLocale !== locale && (
        <Cell class="untranslated">
          <p>{t("note.untranslated")}</p>
        </Cell>
      )}
      <Cell as="header" class="title-block">
        <h1 lang={contentLocale}>{title}</h1>
        <div class="facts">
          <FactList
            facts={[
              { term: t("note.published"), value: formatDate(pubDate, locale), data: true },
              ...(updatedDate ? [{ term: t("note.updated"), value: formatDate(updatedDate, locale), data: true }] : []),
            ]}
          />
          {source && (
            <p class="source">
              <a class="tap" href={source.url}>
                {t("note.source", { platform: platforms[source.platform] })}
                <ExternalMark href={source.url} />
              </a>
            </p>
          )}
        </div>
      </Cell>
      <ArticleBody {headings} lang={contentLocale}>
        <Content components={{ Figure, Video }} />
      </ArticleBody>
    </Sheet>
  </article>
</BaseLayout>

<style>
  .page {
    padding-block-start: var(--layout-gutter);
  }

  /* Until the entry has its French file (docs/i18n.md, phase 4). */
  .untranslated {
    color: var(--color-text-muted);
    font-size: var(--font-size-step-minus-1);
  }

  /* As on a case study, one step down: a note's title is a sentence, not a name. */
  .title-block {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-12) var(--space-8);
  }

  h1 {
    font-size: var(--font-size-step-4);
    line-height: var(--line-height-title);
  }

  .facts {
    display: grid;
    gap: var(--space-4);
  }

  /* On wide screens the title block takes the body's columns: the title across the section
     titles and the text, the dates over the list of sections, at the foot of the title. */
  @media (width >= 60rem) {
    .title-block {
      grid-template-columns: subgrid;
    }

    h1 {
      grid-column: 1 / span 9;
    }

    .facts {
      grid-column: 10 / -1;
      align-self: end;
      padding-inline-start: var(--space-4);
    }
  }

  .source a {
    color: var(--color-link);
    font-weight: var(--font-weight-strong);
  }
</style>
