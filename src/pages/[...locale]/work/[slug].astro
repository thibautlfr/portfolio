---
import Figure from "@/components/mdx/Figure.astro";
import Video from "@/components/mdx/Video.astro";
import ProjectBrief from "@/components/project/ProjectBrief.astro";
import Breadcrumbs from "@/components/site/Breadcrumbs.astro";
import ArticleBody from "@/components/ui/ArticleBody.astro";
import Cell from "@/components/ui/Cell.astro";
import ExternalMark from "@/components/ui/ExternalMark.astro";
import FactList from "@/components/ui/FactList.astro";
import Sheet from "@/components/ui/Sheet.astro";
import ZoomMedia from "@/components/ui/ZoomMedia.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { localProfile } from "@/data/profile";
import { getLocalizedCollection, renderLocalized, type LocalizedEntry } from "@/i18n/content";
import { localeOf, localeParam, locales, localizePath, ogPath } from "@/i18n/locales";
import { useTranslations } from "@/i18n/ui";
import { selectPublished } from "@/lib/content";
import { formatClient, formatContext } from "@/lib/format";
import { breadcrumbs, work } from "@/lib/seo/json-ld";

export async function getStaticPaths() {
  const paths = await Promise.all(
    locales.map(async (locale) => {
      const projects = selectPublished(await getLocalizedCollection("projects", locale));
      return projects.map((project, index) => ({
        params: { locale: localeParam(locale), slug: project.id },
        props: { project, next: projects[(index + 1) % projects.length] },
      }));
    }),
  );
  return paths.flat();
}

interface Props {
  project: LocalizedEntry<"projects">;
  next: LocalizedEntry<"projects"> | undefined;
}

const { project, next } = Astro.props;
const {
  title,
  summary,
  role,
  context,
  client,
  year,
  stack,
  cover,
  gallery,
  links,
  award,
  decisions,
  figures,
  schemaType,
  seo,
} = project.data;
const { Content, headings } = await renderLocalized(project);

const locale = localeOf(Astro.url);
const t = useTranslations(locale);
const profile = localProfile(locale);
const home = localizePath("/", locale);
const site = Astro.site ?? Astro.url;
const url = new URL(localizePath(`/work/${project.id}/`, locale), site).href;
const source = links.find((link) => link.kind === "source");
---

<BaseLayout
  title={`${seo?.title ?? title}, ${t("work.titleSuffix")} · ${profile.name}`}
  description={seo?.description ?? summary}
  ogImage={ogPath(`/work/${project.id}`, locale)}
  type="article"
  jsonLd={[
    work({
      type: schemaType,
      name: title,
      description: summary,
      url,
      authorUrl: site.href,
      inLanguage: locale,
      keywords: stack,
      ...(year && { year }),
      ...(source && { codeRepository: source.url }),
      ...(client && { producer: client }),
    }),
    breadcrumbs([
      { name: profile.name, url: new URL(home, site).href },
      { name: title, url },
    ]),
  ]}
  {locales}
>
  <article class="page">
    <Sheet as="div">
      <Breadcrumbs items={[{ label: profile.name, href: home }, { label: title }]} {locales} />
      <Cell as="header" class:list={["title-block", { "has-cover": cover }]}>
        <div class="intro">
          <h1>{title}</h1>
          <p class="summary">{summary}</p>
          {award && <p class="award">{award}</p>}
          <div class="facts">
            <FactList
              facts={[
                { term: t("facts.context"), value: formatContext(t(`context.${context}`), year) },
                ...(client ? [{ term: t("facts.client"), value: formatClient(client) }] : []),
                { term: t("facts.role"), value: role },
                { term: t("facts.stack"), value: stack },
              ]}
            />
            {links.length > 0 && (
              <ul role="list" class="links">
                {links.map((link) => (
                  <li>
                    <a class="tap" href={link.url} data-umami-event={`project-${link.kind}`}>
                      {link.label}
                      <ExternalMark href={link.url} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
        {cover && (
          <figure class="cover">
            <ZoomMedia src={cover.src} alt={cover.alt} ratio="16 / 10" sizes="(width >= 60rem) 50vw, 100vw" priority />
            {gallery && (
              <div class="gallery">
                {gallery.map((picture) => (
                  <ZoomMedia src={picture.src} alt={picture.alt} ratio="16 / 10" sizes="(width >= 60rem) 25vw, 50vw" />
                ))}
              </div>
            )}
          </figure>
        )}
      </Cell>
      {(decisions || figures) && <ProjectBrief {decisions} {figures} />}
      <ArticleBody {headings}>
        <Content components={{ Figure, Video }} />
      </ArticleBody>
      {next && next.id !== project.id && (
        <Cell as="footer" class="next card">
          <p class="next-label">{t("work.next")}</p>
          <p class="next-title">
            <a class="card-link" href={localizePath(`/work/${next.id}/`, locale)}>
              {next.data.title}
            </a>
          </p>
        </Cell>
      )}
    </Sheet>
  </article>
</BaseLayout>

<style>
  .page {
    padding-block-start: var(--layout-gutter);
  }

  .title-block {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-12) var(--space-8);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  h1 {
    font-size: var(--font-size-step-5);
    line-height: var(--line-height-tight);
  }

  .summary {
    max-inline-size: var(--layout-measure);
    font-size: var(--font-size-step-1);
    line-height: var(--line-height-lede);
  }

  .award {
    align-self: start;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-accent);
    font-size: var(--font-size-step-minus-1);
    font-weight: var(--font-weight-strong);
  }

  .facts {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-4);
  }

  /* Rows far enough apart that the links' touch targets (.tap) do not overlap. */
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-4);
  }

  .links a {
    color: var(--color-link);
    font-weight: var(--font-weight-strong);
  }

  /* The gallery: the other views, side by side under the cover, at its ratio. */
  .cover {
    display: grid;
    gap: var(--space-4);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  /* On wide screens the cover shares the header with the title, half each. The text runs
     the cover's height: title and summary at the top, facts and links at the bottom. */
  @media (width >= 60rem) {
    .title-block.has-cover {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .has-cover .facts {
      margin-block-start: auto;
      padding-block-start: var(--space-4);
    }

    .cover {
      align-self: start;
    }
  }

  .next {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-8);
  }

  .next-label {
    color: var(--color-text-muted);
    font-size: var(--font-size-step-minus-1);
  }

  .next-title {
    font-family: var(--font-title);
    font-size: var(--font-size-step-3);
    font-weight: var(--font-weight-title);
  }
</style>
