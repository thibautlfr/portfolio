---
import { getCollection, render, type CollectionEntry } from "astro:content";

import Figure from "@/components/mdx/Figure.astro";
import Video from "@/components/mdx/Video.astro";
import ProjectBrief from "@/components/project/ProjectBrief.astro";
import SectionIndex from "@/components/project/SectionIndex.astro";
import Breadcrumbs from "@/components/site/Breadcrumbs.astro";
import Cell from "@/components/ui/Cell.astro";
import FactList from "@/components/ui/FactList.astro";
import Media from "@/components/ui/Media.astro";
import Sheet from "@/components/ui/Sheet.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile } from "@/data/profile";
import { selectPublished } from "@/lib/content";
import { formatClient, formatContext } from "@/lib/format";
import { breadcrumbs, work } from "@/lib/seo/json-ld";

export async function getStaticPaths() {
  const projects = selectPublished(await getCollection("projects"));
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
  next: CollectionEntry<"projects"> | undefined;
}

const { project, next } = Astro.props;
const { title, summary, role, context, client, year, stack, cover, links, award, decisions, figures, schemaType, seo } =
  project.data;
const { Content, headings } = await render(project);
const sections = headings.filter((heading) => heading.depth === 2);

const site = Astro.site ?? Astro.url;
const url = new URL(`/work/${project.id}/`, site).href;
const source = links.find((link) => link.kind === "source");
---

<BaseLayout
  title={`${seo?.title ?? title}, case study · ${profile.name}`}
  description={seo?.description ?? summary}
  ogImage={`/og/work/${project.id}.png`}
  type="article"
  jsonLd={[
    work({
      type: schemaType,
      name: title,
      description: summary,
      url,
      authorUrl: site.href,
      keywords: stack,
      ...(year && { year }),
      ...(source && { codeRepository: source.url }),
      ...(client && { producer: client }),
    }),
    breadcrumbs([
      { name: profile.name, url: site.href },
      { name: title, url },
    ]),
  ]}
>
  <article class="page">
    <Sheet as="div">
      <Breadcrumbs items={[{ label: profile.name, href: "/" }, { label: title }]} />
      <Cell span={cover ? 7 : 12} as="header" class="title-block">
        <h1>{title}</h1>
        <p class="summary">{summary}</p>
        {award && <p class="award">{award}</p>}
        <div class="facts">
          <FactList
            facts={[
              { term: "Context", value: formatContext(context, year) },
              ...(client ? [{ term: "Client", value: formatClient(client) }] : []),
              { term: "Role", value: role },
              { term: "Stack", value: stack },
            ]}
          />
          {links.length > 0 && (
            <ul role="list" class="links">
              {links.map((link) => (
                <li>
                  <a href={link.url} data-umami-event={`project-${link.kind}`}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </Cell>
      {cover && (
        <Cell span={5} flush as="figure" class="cover">
          <Media src={cover.src} alt={cover.alt} ratio="16 / 10" sizes="(width >= 60rem) 42vw, 100vw" priority />
        </Cell>
      )}
      {(decisions || figures) && <ProjectBrief {decisions} {figures} />}
      <Cell span={9} class="body">
        <div class="prose">
          <Content components={{ Figure, Video }} />
        </div>
      </Cell>
      <Cell span={3} class="sections">
        <SectionIndex headings={sections} />
      </Cell>
      {next && next.id !== project.id && (
        <Cell as="footer" class="next">
          <p class="next-label">Next case study</p>
          <p class="next-title">
            <a href={`/work/${next.id}/`}>{next.data.title}</a>
          </p>
        </Cell>
      )}
    </Sheet>
  </article>
</BaseLayout>

<style>
  .page {
    padding-block-start: var(--layout-gutter);
  }

  .title-block {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding-block: var(--space-12) var(--space-8);
  }

  h1 {
    font-size: var(--font-size-step-5);
    line-height: var(--line-height-tight);
  }

  .summary {
    max-inline-size: var(--layout-measure);
    font-size: var(--font-size-step-1);
    line-height: var(--line-height-lede);
  }

  .award {
    justify-self: start;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-accent);
    font-size: var(--font-size-step-minus-1);
    font-weight: var(--font-weight-strong);
  }

  .facts {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-4);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .links a {
    color: var(--color-link);
    font-weight: var(--font-weight-strong);
  }

  /* The cover keeps its ratio at the top of its cell, however tall the title block runs. */
  .cover {
    align-self: start;
  }

  /* The body is ruled and numbered like a specification: each section's title in a narrow
     column, its text beside it, a hairline between sections. */
  .body {
    padding-block: var(--space-12) var(--space-16);
  }

  .body :global(.prose) {
    container-type: inline-size;
    counter-reset: section;
    max-inline-size: none;
    font-size: var(--font-size-step-0);
    line-height: var(--line-height-text);
  }

  .body :global(.prose > h2) {
    position: relative;
    counter-increment: section;
    margin-block-start: var(--space-16);
    font-size: var(--font-size-step-1);
    line-height: var(--line-height-title);
    scroll-margin-block-start: var(--space-8);
  }

  .body :global(.prose > h2:first-child),
  .body :global(.prose > h2:first-child + *) {
    margin-block-start: 0;
  }

  /* The section's number, as in the list of sections beside the text. */
  .body :global(.prose > h2::before) {
    display: block;
    margin-block-end: var(--space-1);
    color: var(--color-text-muted);
    font-family: var(--font-text);
    font-size: var(--font-size-step-minus-1);
    font-weight: var(--font-weight-text);
    font-variant-numeric: tabular-nums;
    content: counter(section, decimal-leading-zero);
  }

  /* The rule above a section runs across both columns of the body. */
  .body :global(.prose > h2::after) {
    --rule-offset: calc(-1 * var(--space-8));

    position: absolute;
    inset-block-start: var(--rule-offset);
    inset-inline-start: 0;
    inline-size: 100cqi;
    border-block-start: var(--border-hairline);
    content: "";
  }

  .body :global(.prose > h2:first-child::after) {
    content: none;
  }

  .sections {
    display: none;
  }

  @media (width >= 60rem) {
    .body :global(.prose) {
      display: grid;
      grid-template-columns: repeat(9, minmax(0, 1fr));
      column-gap: var(--space-8);
    }

    .body :global(.prose > *) {
      grid-column: 3 / -1;
      max-inline-size: var(--layout-measure-wide);
    }

    .body :global(.prose > h2) {
      grid-column: 1 / span 2;
    }

    /* A section's first block sits on the same row as its title. */
    .body :global(.prose > h2:not(:first-child) + *) {
      margin-block-start: var(--space-16);
    }

    .body :global(.prose > figure),
    .body :global(.prose > pre) {
      max-inline-size: none;
    }

    .sections {
      display: block;
      padding-block: var(--space-12);
    }
  }

  .next {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-8);
  }

  .next-label {
    color: var(--color-text-muted);
    font-size: var(--font-size-step-minus-1);
  }

  .next-title {
    font-family: var(--font-title);
    font-size: var(--font-size-step-3);
    font-weight: var(--font-weight-title);
  }
</style>
