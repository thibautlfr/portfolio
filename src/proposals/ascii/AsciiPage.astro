---
// Proposals page: the dynamic ASCII hero, in four modes and several palettes, each at the
// hero's size. Registered by the proposals integration in astro.config.ts.
import Cell from "@/components/ui/Cell.astro";
import Sheet from "@/components/ui/Sheet.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const modes = [
  {
    id: "density",
    name: "A. Density",
    text: "The warp read out as a classic ASCII ramp, from a space to @. The densest characters take the accent colour; the cursor thickens the type around it.",
  },
  {
    id: "contours",
    name: "B. Contours",
    text: "Only the level lines of the warp, drawn with - / | \\ along their direction, dots inside the high ground. A moving topographic map in text.",
  },
  {
    id: "decode",
    name: "C. Decode",
    text: "The ramp holds still where the field is calm; where it moves, and around the cursor, characters scramble through the alphabet before settling. Like text being decoded.",
  },
  {
    id: "words",
    name: "D. Words",
    text: "The stack, the city and the email, typed across the whole frame and drifting along the lines. The warp inks them in and out; the cursor reveals them.",
  },
];
const palettes = [
  ["paper", "Paper: sage ink on the page's ground, teal accent"],
  ["mono", "Mono: greys on white, no colour"],
  ["coral", "Coral: sage ink on the ground, coral accent"],
  ["ink", "Ink: grey-green and ivory on the shader's ink"],
  ["teal", "Teal: light teal on deep teal"],
];
---

<BaseLayout title="ASCII hero proposals" description="Development review page." noindex>
  <div class="page">
    <Sheet aria-label="Palette">
      <Cell class="palettes">
        <p>Palette</p>
        {palettes.map(([id, label], index) => (
          <label>
            <input type="radio" name="palette" value={id} checked={index === 0} />
            {label}
          </label>
        ))}
      </Cell>
    </Sheet>
    {modes.map((mode) => (
      <Sheet aria-labelledby={`ascii-${mode.id}`}>
        <Cell span={8} flush class="stage" data-ascii={mode.id}>
          <canvas aria-hidden="true" />
        </Cell>
        <Cell span={4} class="about">
          <h2 id={`ascii-${mode.id}`}>{mode.name}</h2>
          <p>{mode.text}</p>
        </Cell>
      </Sheet>
    ))}
  </div>
</BaseLayout>

<script>
  import { runAscii, type PaletteName } from "@/proposals/ascii/lab";

  let palette: PaletteName = "paper";
  for (const input of document.querySelectorAll<HTMLInputElement>("input[name=palette]")) {
    input.addEventListener("change", () => (palette = input.value as PaletteName));
  }
  for (const root of document.querySelectorAll<HTMLElement>("[data-ascii]")) {
    void runAscii(root, root.dataset["ascii"] as "density", () => palette);
  }
</script>

<style>
  .page {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--layout-gutter);
  }

  .palettes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    font-size: var(--font-size-step-minus-1);
  }

  .palettes p {
    font-weight: var(--font-weight-strong);
  }

  .stage {
    position: relative;
    min-block-size: var(--hero-shader-height);
  }

  canvas {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }

  .about {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  h2 {
    font-size: var(--font-size-step-2);
  }

  .about p {
    color: var(--color-text-muted);
  }
</style>
