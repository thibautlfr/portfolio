---
// Switches the page transition proposal (see transitions.css and boot.js). BaseLayout renders
// it only when proposals are enabled.
import { transitionBoot, transitionStyles } from "./index";

interface Props {
  /** head: the styles and the boot script, which must run before the first render. */
  part: "head" | "body";
}

const { part } = Astro.props;

const options = [
  ["crossfade", "0. Crossfade (current)"],
  ["window", "1. Window"],
  ["expand", "2. Expand from the row"],
  ["sheet", "3. Sheet"],
  ["columns", "4. Columns"],
  ["iris", "5. Iris"],
  ["morph", "6. Morph"],
];
---

{part === "head" && <Fragment set:html={`<style>${transitionStyles}</style>`} />}
{part === "head" && <script is:inline set:html={transitionBoot} />}
{part === "body" && (
  <label class="transition-picker">
    Page transition
    <select data-transition-picker>
      {options.map(([value, label]) => (
        <option {value}>{label}</option>
      ))}
    </select>
  </label>
)}
