---
import ArrowLink from "@/components/ui/ArrowLink.astro";
import Cell from "@/components/ui/Cell.astro";
import EmailLink from "@/components/ui/EmailLink.astro";
import Sheet from "@/components/ui/Sheet.astro";
import { profile } from "@/data/profile";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Sheet aria-labelledby="contact-title">
  <!-- The question is the headline; the address answers it in its own face, one step down. -->
  <Cell span={8} class="contact">
    <h2 id="contact-title">{title}</h2>
    <EmailLink size="large" />
  </Cell>
  <Cell span={4} class="socials">
    <ul role="list">
      {profile.socials.map((social) => (
        <li>
          <ArrowLink kind="out" href={social.url} rel="me">
            {social.label}
          </ArrowLink>
        </li>
      ))}
    </ul>
  </Cell>
</Sheet>

<style>
  .contact {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-12);
  }

  h2 {
    max-inline-size: 14ch;
    font-size: var(--font-size-step-4);
  }

  .socials {
    display: grid;
    align-content: end;
    padding-block: var(--space-12);
  }

  .socials ul {
    display: grid;
    gap: var(--space-3);
    font-size: var(--font-size-step-1);
  }
</style>
