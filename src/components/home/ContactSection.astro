---
import Cell from "@/components/ui/Cell.astro";
import EmailLink from "@/components/ui/EmailLink.astro";
import Sheet from "@/components/ui/Sheet.astro";
import { profile } from "@/data/profile";

interface Props {
  title: string;
  /** Label above the social links, set like the hero's labels. */
  socialsLabel: string;
}

const { title, socialsLabel } = Astro.props;
---

<Sheet aria-labelledby="contact-title">
  <!-- The address is the answer and the display line; the question introduces it at title size. -->
  <Cell span={8} class="contact">
    <h2 id="contact-title">{title}</h2>
    <EmailLink size="large" />
  </Cell>
  <!-- Label on the question's line, links on the address's line. -->
  <Cell span={4} class="socials">
    <p id="socials-label" class="label">
      {socialsLabel}
    </p>
    <ul role="list" aria-labelledby="socials-label">
      {profile.socials.map((social) => (
        <li>
          <a href={social.url} rel="me">
            {social.label}
          </a>
        </li>
      ))}
    </ul>
  </Cell>
</Sheet>

<style>
  .contact,
  .socials {
    display: grid;
    align-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  /* On a phone the address is near body size: the question steps down to stay under it. */
  h2 {
    font-size: var(--font-size-step-1);
  }

  @media (width >= 60rem) {
    .contact,
    .socials {
      gap: var(--space-8);
      padding-block: var(--space-12);
    }

    h2 {
      font-size: var(--font-size-step-2);
    }
  }

  .contact :global(.email) {
    line-height: var(--line-height-title);
  }

  .label {
    color: var(--color-text-muted);
    font-size: var(--font-size-step-minus-1);
  }

  .socials ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    font-size: var(--font-size-step-1);
  }
</style>
