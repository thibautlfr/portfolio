---
import type { CollectionEntry } from "astro:content";

import SectionTitle from "@/components/ui/SectionTitle.astro";
import Sheet from "@/components/ui/Sheet.astro";
import NoteListItem from "@/components/note/NoteListItem.astro";
import { localeOf, localizePath } from "@/i18n/locales";
import { useTranslations } from "@/i18n/ui";

interface Props {
  title: string;
  notes: CollectionEntry<"notes">[];
}

const { title, notes } = Astro.props;
const locale = localeOf(Astro.url);
const t = useTranslations(locale);
---

<Sheet aria-labelledby="notes-title">
  <SectionTitle id="notes-title">
    {title}
    <a slot="aside" class="tap" href={localizePath("/notes/", locale)}>
      {t("notes.all")}
    </a>
  </SectionTitle>
  <ol role="list" class="notes">
    {notes.map((note) => (
      <NoteListItem {note} />
    ))}
  </ol>
</Sheet>

<style>
  .notes {
    display: grid;
    grid-column: 1 / -1;
  }
</style>
