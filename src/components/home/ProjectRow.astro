---
import type { CollectionEntry } from "astro:content";

import Arrow from "@/components/ui/Arrow.astro";
import FactList from "@/components/ui/FactList.astro";
import Media from "@/components/ui/Media.astro";
import { formatContext, formatList } from "@/lib/format";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, summary, award, context, year, role, stack, cover } = project.data;
---

<li class:list={["row", { "row--text": !cover }]}>
  <div class="row-main">
    <h3 class="row-title">
      <a href={`/work/${project.id}/`}>
        <span class="row-title-text">{title}</span>
        <Arrow />
      </a>
    </h3>
    <p class="row-summary">{summary}</p>
    {award && <p class="row-award">{award}</p>}
  </div>
  <div class="row-facts">
    <FactList
      facts={[
        { term: "Context", value: formatContext(context, year) },
        { term: "Role", value: role },
        { term: "Stack", value: formatList(stack), data: true },
      ]}
    />
  </div>
  {cover && (
    <div class="row-image">
      <Media src={cover.src} alt={cover.alt} ratio="16 / 10" sizes="(width >= 60rem) 33vw, 100vw" />
    </div>
  )}
</li>

<style>
  /* The title's link covers the whole row, so the row is one target. */
  .row {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-4);
    border-inline-end: var(--border-hairline);
    border-block-end: var(--border-hairline);
    background: var(--color-surface);
  }

  .row-main {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .row-title {
    font-size: var(--font-size-step-2);
  }

  .row-title a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-icon);
    text-decoration: none;
    --arrow-shift: -0.4em 0;
  }

  .row-title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .row-title-text {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--duration-quick) var(--ease-snap);
  }

  /* The arrow arrives from behind the title on hover. */
  .row-title :global(.arrow) {
    opacity: 0;
    transition:
      opacity var(--duration-quick) var(--ease-snap),
      translate var(--duration-move) var(--ease-out);
  }

  .row-title a:focus-visible,
  .row:hover .row-title a {
    --arrow-shift: 0;
  }

  .row:hover .row-title :global(.arrow),
  .row-title a:focus-visible :global(.arrow) {
    opacity: 1;
  }

  .row:hover .row-title-text,
  .row-title a:focus-visible .row-title-text {
    text-decoration-color: var(--color-accent);
  }

  /* The frame stays put and the image moves inside it. */
  .row-image {
    overflow: clip;
    outline: var(--border-hairline);
    transition: outline-color var(--duration-quick) var(--ease-snap);
  }

  .row-image :global(.media) {
    outline: none;
    transition: scale var(--duration-move) var(--ease-out);
  }

  .row:hover .row-image {
    outline-color: var(--color-accent);
  }

  .row:hover .row-image :global(.media) {
    scale: 1.03;
  }

  .row-summary {
    max-inline-size: var(--layout-measure);
  }

  .row-award {
    justify-self: start;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-accent);
    font-size: var(--font-size-step-minus-1);
    font-weight: var(--font-weight-strong);
  }

  @media (width >= 60rem) {
    .row {
      grid-column: 1 / -1;
      grid-template-columns: repeat(var(--layout-columns), minmax(0, 1fr));
      gap: var(--space-6);
      padding-block: var(--space-8);
    }

    .row-main {
      grid-column: 1 / span 5;
    }

    .row-facts {
      grid-column: 6 / span 3;
    }

    .row-image {
      grid-column: 9 / -1;
    }

    .row--text .row-main {
      grid-column: 1 / span 7;
    }

    .row--text .row-facts {
      grid-column: 9 / -1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .row {
        animation: reveal-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }
</style>
