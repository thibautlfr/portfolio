---
import ArrowLink from "@/components/ui/ArrowLink.astro";
import Cell from "@/components/ui/Cell.astro";
import FactList from "@/components/ui/FactList.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import Sheet from "@/components/ui/Sheet.astro";
import { profile } from "@/data/profile";
import { formatList } from "@/lib/format";

interface Offer {
  title: string;
  text: string;
}

interface Props {
  title: string;
  offers: Offer[];
}

const { title, offers } = Astro.props;
const { stack, languages, cvPath } = profile;
---

<Sheet aria-labelledby="about-title">
  <SectionTitle id="about-title">{title}</SectionTitle>
  {offers.map((offer) => (
    <Cell span={4} as="article" class="offer">
      <h3>{offer.title}</h3>
      <p>{offer.text}</p>
    </Cell>
  ))}
  <Cell span={4} class="facts">
    <FactList
      facts={[
        { term: "Languages", value: formatList(stack.languages), data: true },
        { term: "Front-end", value: formatList(stack.frontEnd), data: true },
        { term: "Back-end", value: formatList(stack.backEnd), data: true },
        { term: "Speaks", value: languages.join(", ") },
      ]}
    />
    {cvPath && (
      <ArrowLink kind="down" class="cv" href={cvPath} data-umami-event="cv">
        Download my CV (PDF)
      </ArrowLink>
    )}
  </Cell>
</Sheet>

<style>
  /* The offer's name is a title, its text reads as body copy under it. */
  .offer {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-8);
  }

  h3 {
    font-size: var(--font-size-step-2);
  }

  .offer p {
    max-inline-size: var(--layout-measure);
    color: var(--color-text-muted);
  }

  .facts {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-8);
  }

  .facts :global(.cv) {
    justify-self: start;
    color: var(--color-link);
    font-weight: var(--font-weight-strong);
  }
</style>
