---
import { Image } from "astro:assets";

import shaderFrame from "@/assets/images/shader-frame.jpg";
// Built by Vite as a standalone ES module (vite.worker.format is "es"); only its URL ships in
// the page, so nothing is requested before the inline boot step below decides to load it.
import shaderModule from "@/scripts/hero-shader/index.ts?worker&url";
import heroBootScript from "@/scripts/hero-shader/boot-inline.js?raw";
import Cell from "@/components/ui/Cell.astro";
import EmailLink from "@/components/ui/EmailLink.astro";
import Media from "@/components/ui/Media.astro";
import Sheet from "@/components/ui/Sheet.astro";
import { profile } from "@/data/profile";
import { formatList } from "@/lib/format";

const stack = Object.values(profile.stack).flat();
---

<Sheet aria-labelledby="hero-title" class="hero">
  <Cell span={9} class="hero-name">
    <h1 id="hero-title" class="wordmark">
      <span>{profile.givenName}</span>
      <span>{profile.familyName}</span>
    </h1>
    <p class="role">{profile.role}</p>
  </Cell>

  <Cell span={3} flush as="figure" class="hero-portrait">
    <Media
      src={profile.portrait.src}
      alt={profile.portrait.alt}
      ratio="1 / 1"
      sizes="(width >= 60rem) 25vw, 50vw"
      priority
    />
  </Cell>

  <Cell span={8} flush as="figure" class="hero-shader" data-hero-shader={shaderModule}>
    <div class="shader-frame">
      <Image
        class="shader-still"
        src={shaderFrame}
        alt=""
        format="avif"
        quality={45}
        loading="lazy"
        fetchpriority="low"
        widths={[640, 960, 1440]}
        sizes="(width >= 60rem) 66vw, 100vw"
      />
      <canvas class="shader-canvas" data-hero-shader-canvas aria-hidden="true"></canvas>
    </div>
    <figcaption>
      <span>Domain warp, live. It drifts toward a wandering point, then follows your cursor.</span>
      <button type="button" data-hero-shader-toggle aria-pressed="false" hidden>
        Pause animation
      </button>
    </figcaption>
  </Cell>

  <Cell span={4} class="hero-pitch">
    <p class="positioning">{profile.positioning}</p>
    <EmailLink />
  </Cell>

  <Cell span={4} class="hero-base">
    <p class="label">Base</p>
    <p>
      {profile.location.city}, {profile.location.country}
    </p>
    <p class="data coordinates">{profile.location.coordinates}</p>
  </Cell>
  <Cell span={4} class="hero-mobility">
    <p class="label">Mobility</p>
    <p>{profile.mobility}.</p>
  </Cell>
  <Cell span={4} class="hero-stack">
    <p class="label">Stack</p>
    <p>{formatList(stack)}</p>
  </Cell>
</Sheet>

<!-- Inline boot step (see boot-inline.js). -->
<script is:inline set:html={heroBootScript} />
<style>
  /* Below 60rem the sheet becomes two columns so the portrait can sit beside
     the base; the pitch comes right after the name, before the shader. The
     portrait column stays narrower than the pitch, which keeps the pitch text
     (painted with the first frame) as the largest element of the first view. */
  .hero {
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
  }

  .hero-name,
  .hero-pitch,
  .hero-shader,
  .hero-mobility,
  .hero-stack {
    grid-column: 1 / -1;
  }

  .hero-portrait,
  .hero-base {
    order: 2;
  }

  .hero-mobility {
    order: 3;
  }

  .hero-stack {
    order: 4;
  }

  @media (width >= 60rem) {
    .hero {
      grid-template-columns: repeat(var(--layout-columns), minmax(0, 1fr));
    }

    .hero > * {
      order: 0;
    }

    .hero-name,
    .hero-pitch,
    .hero-shader,
    .hero-mobility,
    .hero-stack {
      grid-column: span var(--cell-span);
    }
  }

  .hero-name {
    display: grid;
    align-content: space-between;
    gap: var(--space-8);
    padding-block: var(--space-6);
  }

  .wordmark {
    font-family: var(--font-wordmark);
    font-size: var(--font-size-step-5);
    font-weight: var(--font-weight-wordmark);
    font-stretch: var(--font-stretch-wordmark);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-wordmark);
  }

  .wordmark span {
    display: block;
  }

  .role {
    font-size: var(--font-size-step-1);
    font-weight: var(--font-weight-strong);
  }

  .hero-portrait :global(img) {
    filter: grayscale(1);
    outline: none;
  }

  .hero-shader {
    order: 5;
    display: grid;
    grid-template-rows: 1fr auto;
  }

  /* The still frame holds the space and stays under the canvas, so the live
     shader fades in without any layout shift. */
  .shader-frame {
    position: relative;
    min-block-size: var(--hero-shader-height);
    overflow: hidden;
    background: var(--color-shader-ground);
  }

  .shader-still,
  .shader-canvas {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .shader-canvas {
    opacity: 0;
    transition: opacity var(--duration-fade) var(--ease-snap);
  }

  .hero-shader:global(.is-live) .shader-canvas {
    opacity: 1;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding: var(--space-3) var(--space-4);
    border-block-start: var(--border-hairline);
    color: var(--color-text-muted);
    font-size: var(--font-size-step-minus-1);
  }

  .hero-pitch {
    order: 1;
    display: grid;
    align-content: space-between;
    gap: var(--space-6);
  }

  figcaption button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .positioning {
    max-inline-size: var(--layout-measure);
    font-size: var(--font-size-step-1);
    line-height: var(--line-height-lede);
  }

  .label {
    color: var(--color-text-muted);
    font-size: var(--font-size-step-minus-1);
  }

  .data {
    font-family: var(--font-data);
    font-size: var(--font-size-data);
    font-variant-numeric: tabular-nums;
  }
</style>

<style>
  .coordinates {
    white-space: nowrap;
  }
</style>
