---
import LanguageSwitch from "@/components/site/LanguageSwitch.astro";
import { profile } from "@/data/profile";
import { localeOf, localizePath, type Locale } from "@/i18n/locales";
import { useTranslations } from "@/i18n/ui";

interface Props {
  /** The languages the page exists in, for the switch. */
  locales: readonly Locale[];
}

const { locales } = Astro.props;
const locale = localeOf(Astro.url);
const t = useTranslations(locale);
const year = new Date().getFullYear();
// The design system is in English only.
const links = [
  { label: t("footer.designSystem"), path: "/design-system/" },
  { label: t("footer.legalNotice"), path: localizePath("/legal-notice/", locale) },
];
const current = Astro.url.pathname.replace(/\/?$/, "/");
---

<footer class="site-footer">
  <p>
    &copy; {year} {profile.name}
  </p>
  <p class="links">
    {links.map(({ label, path }) =>
      current === path ? (
        <span aria-current="page">{label}</span>
      ) : (
        <a class="tap" href={path}>
          {label}
        </a>
      ),
    )}
  </p>
  {/* Outside the paragraph: the switch is a nav, which a p cannot hold. */}
  <div class="languages">
    <LanguageSwitch available={locales} />
  </div>
</footer>

<style>
  /* Three blocks on wide screens: the credit on the left edge, the links in the true middle,
     the languages on the right edge. Below, the credit takes a row and the two others share
     the next one. */
  .site-footer {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-4);
    padding: var(--space-6) var(--layout-gutter) var(--space-12);
    color: var(--color-text-muted);
    font-size: var(--font-size-step-minus-1);
  }

  .site-footer > :first-child {
    grid-column: 1 / -1;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .languages {
    justify-self: end;
  }

  @media (width >= 60rem) {
    .site-footer {
      grid-template-columns: 1fr auto 1fr;
    }

    .site-footer > :first-child {
      grid-column: auto;
    }
  }
</style>
