---
import LanguageSwitch from "@/components/site/LanguageSwitch.astro";
import { profile } from "@/data/profile";
import { localeOf, type Locale } from "@/i18n/locales";
import { useTranslations } from "@/i18n/ui";

interface Props {
  /** The languages the page exists in, for the switch. */
  locales: readonly Locale[];
}

const { locales } = Astro.props;
const t = useTranslations(localeOf(Astro.url));
const year = new Date().getFullYear();
// Both stay in English until the legal notice is translated (docs/i18n.md, phase 3).
const links = [
  { label: t("footer.designSystem"), path: "/design-system/" },
  { label: t("footer.legalNotice"), path: "/legal-notice/" },
];
const current = Astro.url.pathname.replace(/\/?$/, "/");
---

<footer class="site-footer">
  <p>
    &copy; {year} {profile.name}
  </p>
  <p class="links">
    {links.map(({ label, path }) =>
      current === path ? (
        <span aria-current="page">{label}</span>
      ) : (
        <a class="tap" href={path}>
          {label}
        </a>
      ),
    )}
    <LanguageSwitch available={locales} />
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6) var(--layout-gutter) var(--space-12);
    color: var(--color-text-muted);
    font-size: var(--font-size-step-minus-1);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
</style>
