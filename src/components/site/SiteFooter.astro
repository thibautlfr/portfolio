---
import { profile } from "@/data/profile";

const year = new Date().getFullYear();
const legalPath = "/legal-notice/";
const onLegalNotice = Astro.url.pathname.replace(/\/?$/, "/") === legalPath;
---

<footer class="site-footer">
  <p>
    &copy; {year} {profile.name}
  </p>
  <p>{onLegalNotice ? <span aria-current="page">Legal notice</span> : <a href={legalPath}>Legal notice</a>}</p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6) var(--layout-gutter) var(--space-12);
    color: var(--color-text-muted);
    font-size: var(--font-size-step-minus-1);
  }
</style>
