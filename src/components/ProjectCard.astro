---
import Link from "@components/icons/Link.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Deployment {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  date: number;
  status: "finished" | "wip";
  stack: string[];
  deployments?: Deployment[];
  repository?: string;
  cover?: ImageMetadata;
}

const { title, description, date, status, stack, deployments, repository, cover } =
  Astro.props;

const coverHref = deployments?.[0]?.url;
const linkClass =
  "hover:text-teal-9 inline-flex items-center gap-1 text-sm underline";
const coverClass =
  "border-sage-6 aspect-video w-full rounded-md border object-cover";
---

<article
  class:list={[
    "grid gap-6",
    cover &&
      "md:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] lg:grid-cols-[minmax(0,1fr)_minmax(0,40rem)]",
  ]}
>
  <div class="flex flex-col gap-3">
    <div class="flex items-center gap-3">
      <h3 class="text-xl font-bold md:text-2xl">{title}</h3>
      {
        status === "wip" && (
          <span class="border-sage-7 text-sage-11 rounded-full border px-2 text-xs">
            in progress
          </span>
        )
      }
    </div>

    <div>
      <p class="text-sage-11">Date</p>
      <p>{date}</p>
    </div>

    <div class="max-w-prose">
      <p class="text-sage-11">Description</p>
      <p>{description}</p>
    </div>

    <div>
      <p class="text-sage-11">Stack</p>
      <ul class="flex flex-wrap gap-2 text-xs">
        {
          stack.map((tech) => (
            <li class="border-sage-7 rounded-sm border px-2 py-1">{tech}</li>
          ))
        }
      </ul>
    </div>

    {
      deployments && deployments.length > 0 && (
        <div>
          <p class="text-sage-11">Deployments</p>
          <ul class="mt-1 flex flex-col gap-1">
            {deployments.map((d) => (
              <li>
                <a
                  href={d.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={linkClass}
                >
                  {d.name}
                  <Link />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      repository && (
        <div>
          <p class="text-sage-11">Code Source</p>
          <a
            href={repository}
            target="_blank"
            rel="noopener noreferrer"
            class={linkClass}
          >
            {repository}
            <Link />
          </a>
        </div>
      )
    }
  </div>

  {
    cover && (
      <div class="md:self-start">
        {coverHref ? (
          <a href={coverHref} target="_blank" rel="noopener noreferrer">
            <Image
              src={cover}
              alt={`${title} project cover`}
              class={coverClass}
              width={1200}
              densities={[1, 2]}
              quality={80}
            />
          </a>
        ) : (
          <Image
            src={cover}
            alt={`${title} project cover`}
            class={coverClass}
            width={1200}
            densities={[1, 2]}
            quality={80}
          />
        )}
      </div>
    )
  }
</article>
