---
interface Props {
  /** Data set in mono: the scramble keeps every character's width only in a monospaced face. */
  text: string;
  /** Scramble the digits and leave letters alone (coordinates keep N and W). */
  digitsOnly?: boolean;
}

const { text, digitsOnly = false } = Astro.props;
---

<!-- The text is read from the hidden copy; the visible one is redrawn by scramble.ts when an
     ancestor marked data-scramble-trigger is pointed at, and can never be read half-scrambled. -->
<span class="visually-hidden">{text}</span>
<span class="scramble" aria-hidden="true" data-scramble={digitsOnly ? "digits" : "all"}>
  {text}
</span>

<!-- Bundled once per page however many instances it has, so the module ships as one file. -->
<script>
  import "@/scripts/scramble";
</script>

<style>
  /* A copy of the selection holds the real text once. */
  .scramble {
    user-select: none;
  }
</style>
