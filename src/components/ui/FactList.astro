---
interface Fact {
  term: string;
  value: string;
  /** Set in mono: the value is data (stack, coordinates, versions). */
  data?: boolean;
}

interface Props {
  facts: Fact[];
}

const { facts } = Astro.props;
---

<dl class="facts">
  {facts.map(({ term, value, data = false }) => (
    <div class="fact">
      <dt>{term}</dt>
      <dd class:list={{ data }}>{value}</dd>
    </div>
  ))}
</dl>

<style>
  /* Terms share one column, as wide as the longest term. The size is a variant: secondary
     metadata by default, body size where the list is the content (--facts-size). */
  .facts {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    font-size: var(--facts-size, var(--font-size-step-minus-1));
  }

  .fact {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
  }

  dt {
    color: var(--color-text-muted);
  }

  .data {
    font-family: var(--font-data);
    font-size: var(--font-size-data);
    font-variant-numeric: tabular-nums;
  }
</style>
