---
interface Fact {
  term: string;
  value: string;
  /** Set in mono: the value is data (stack, coordinates, versions). */
  data?: boolean;
}

interface Props {
  facts: Fact[];
}

const { facts } = Astro.props;
---

<dl class="facts">
  {facts.map(({ term, value, data = false }) => (
    <div class="fact">
      <dt>{term}</dt>
      <dd class:list={{ data }}>{value}</dd>
    </div>
  ))}
</dl>

<style>
  .facts {
    display: grid;
    gap: var(--space-2);
    font-size: var(--font-size-step-minus-1);
  }

  .fact {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-3);
  }

  dt {
    color: var(--color-text-muted);
  }

  .data {
    font-family: var(--font-data);
    font-variant-numeric: tabular-nums;
  }
</style>
