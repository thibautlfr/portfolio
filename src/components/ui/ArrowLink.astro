---
import type { HTMLAttributes } from "astro/types";

import Arrow from "./Arrow.astro";

type Props = HTMLAttributes<"a"> & {
  href: string;
  /**
   * next: an internal page, the arrow steps forward. out: another site, it lifts toward
   * the corner. down: a file, it drops. back: the way home, it steps back.
   */
  kind?: "next" | "out" | "down" | "back";
};

const { kind = "next", class: className, ...attributes } = Astro.props;
const direction = ({ next: "east", out: "north-east", down: "south", back: "west" } as const)[kind];
---

<a class:list={["arrow-link", `arrow-link--${kind}`, className]} {...attributes}>
  {kind === "back" && <Arrow {direction} />}
  <span class="arrow-link-text">
    <slot />
  </span>
  {kind !== "back" && <Arrow {direction} />}
</a>

<style>
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-icon);
    text-decoration: none;
  }

  .arrow-link-text {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-thickness var(--duration-quick) var(--ease-snap);
  }

  .arrow-link:hover .arrow-link-text,
  .arrow-link:focus-visible .arrow-link-text {
    text-decoration-thickness: 2px;
  }

  .arrow-link--next:hover,
  .arrow-link--next:focus-visible {
    --arrow-shift: 0.25em 0;
  }

  .arrow-link--out:hover,
  .arrow-link--out:focus-visible {
    --arrow-shift: 0.15em -0.15em;
  }

  .arrow-link--down:hover,
  .arrow-link--down:focus-visible {
    --arrow-shift: 0 0.2em;
  }

  .arrow-link--back:hover,
  .arrow-link--back:focus-visible {
    --arrow-shift: -0.25em 0;
  }
</style>
